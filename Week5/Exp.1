#include <stdio.h>

int main() {
    float a, b, c, d;
    float max, min;

    printf("Enter four numbers: ");
    scanf("%f %f %f %f", &a, &b, &c, &d);

    // Finding Maximum
    if (a >= b && a >= c && a >= d) {
        max = a;
    } else if (b >= c && b >= d) {
        max = b;
    } else if (c >= d) {
        max = c;
    } else {
        max = d;
    }

    // Finding Minimum
    if (a <= b && a <= c && a <= d) {
        min = a;
    } else if (b <= c && b <= d) {
        min = b;
    } else if (c <= d) {
        min = c;
    } else {
        min = d;
    }

    printf("Maximum number: %.2f\n", max);
    printf("Minimum number: %.2f\n", min);

    return 0;
}

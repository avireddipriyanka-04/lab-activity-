#include <stdio.h>

int main()
{
    float u, a, t, distance;

    printf("Enter initial velocity: ");
    scanf("%f", &u);

    printf("Enter acceleration: ");
    scanf("%f", &a);

    printf("Enter time: ");
    scanf("%f", &t);

    distance = u * t + 0.5 * a * t * t;

    printf("Distance travelled = %.2f", distance);

    return 0;
}
